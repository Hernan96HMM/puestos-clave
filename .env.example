# Next.js app runtime (rol puestos_clave_app, sin BYPASSRLS). Hostname
# `puestosclave_db` = nombre del servicio/contenedor Postgres en la red
# sicalab_default (docker-compose.yml) — nunca localhost ni la IP pública.
DATABASE_URL=postgresql://puestos_clave_app:REEMPLAZAR@puestosclave_db:5432/puestos_clave

# Rol dueño de las tablas — usan migrate.mjs, seed.mjs, set-app-role-password.mjs
# y seed-users.mjs. NO se setea en el entorno persistente del contenedor de la
# app (ver docker-compose.yml): se pasa puntualmente al correr cada script,
# por ejemplo desde el host contra el puerto loopback que publica
# puestosclave_db:
#   DATABASE_URL_OWNER=postgresql://puestos_clave_owner:...@localhost:55432/puestos_clave
# o, en producción, vía `docker exec -e DATABASE_URL_OWNER=... sicalab-puestosclave-1
# npm run db:migrate` (ver docs/superpowers/plans/2026-08-12-sicalab-integration-runbook.md).
DATABASE_URL_OWNER=postgresql://puestos_clave_owner:REEMPLAZAR@localhost:55432/puestos_clave

# docker-compose.yml
POSTGRES_OWNER_PASSWORD=REEMPLAZAR
POSTGRES_APP_PASSWORD=REEMPLAZAR

# Auth.js — generar con `npx auth secret`. AUTH_URL debe ser el subdominio
# .sica real detrás de Nginx (propuesta: http://puestosclave.sica — confirmar
# con quien administra el Nginx/DNS interno antes de fijarlo en el server).
AUTH_SECRET=REEMPLAZAR
AUTH_URL=http://puestosclave.sica
# Redundante con trustHost:true en auth.config.ts — reforzado explícito acá
# porque es el mismo fix que se usó en inducciones detrás de Nginx.
AUTH_TRUST_HOST=true

# scripts/seed-users.mjs — credenciales de prueba, no de producción (ver
# docs/superpowers/plans/2026-08-04-credenciales-prueba.md). Opcionales: si
# no están seteadas, el script usa sus defaults de desarrollo documentados ahí.
SEED_PASSWORD_GERENTE_COMPRAS=
SEED_PASSWORD_GERENTE_ALMACENES=
SEED_PASSWORD_DIRECCION=
